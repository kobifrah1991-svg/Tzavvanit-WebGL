{
  "name": "tzivonit-desktop",
  "productName": "Tzivonit",
  "version": "1.0.0",
  "description": "Tzivonit (צבעונית) - brain games for kids, desktop edition",
  "author": "Scitedra Games",
  "homepage": "https://scitedra-games.web.app/tzivonit/",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal"
  },
  "build": {
    "appId": "com.scitedragames.tzivonit",
    "productName": "Tzivonit",
    "copyright": "© Scitedra Games",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../www",
        "to": "www"
      }
    ],
    "artifactName": "Tzivonit-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tzivonit",
      "artifactName": "Tzivonit-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Tzivonit-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.educational-games",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "Tzivonit-${version}-mac.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
